# Copiar como .env en la raíz. Nunca versionar .env ni poner valores reales aquí.

# Runtime
NODE_ENV=development
# development | preview | production. Fuera de production se envía X-Robots-Tag: noindex.
APP_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# CORS de la API: orígenes exactos adicionales, separados por comas (sin *, sin rutas).
# El origen de NEXT_PUBLIC_APP_URL siempre está permitido. En production solo https.
# Vacío = solo el mismo origen. Ejemplo: https://portal.rutasegura.example.org
CORS_ALLOWED_ORIGINS=

# Puertos que Docker Compose publica en el host. Si ya tienes PostgreSQL o Redis
# locales, cámbialos (por ejemplo 55432 y 56379) y ajusta DATABASE_URL y REDIS_URL.
APP_HOST_PORT=3000
# Imagen de la app en Docker Compose: development (next dev) o runner (producción,
# CSP estricta). Las pruebas smoke, los flujos de UI y el pentest usan runner.
APP_BUILD_TARGET=development
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# PostgreSQL: valores locales de ejemplo. Docker Compose sustituye el host por "postgres".
# En Vercel con Supabase usa el pooler en modo transacción (puerto 6543): la app
# detecta ese puerto, desactiva las sentencias preparadas y abre pocas conexiones.
# Las migraciones (pnpm db:migrate) van por la conexión directa o el modo sesión (5432).
DATABASE_URL=postgresql://rutasegura:local_only_change_me@localhost:5432/rutasegura

# Redis. Docker Compose sustituye el host por "redis".
REDIS_URL=redis://localhost:6379

# Auth: generar valores reales fuera del repositorio (openssl rand -base64 32).
# Con APP_ENV=production la app no arranca si detecta estos valores de ejemplo.
SESSION_SECRET=replace_with_at_least_32_random_bytes
CSRF_SECRET=replace_with_at_least_32_random_bytes
HMAC_SECRET=replace_with_at_least_32_random_bytes
# Vida del JWT de acceso (máximo 3600) y de la sesión de refresh, en segundos.
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=28800

# Bloqueo progresivo por cuenta: tras LOCKOUT_THRESHOLD fallos seguidos, bloqueo de
# LOCKOUT_BASE_SECONDS que se duplica en cada bloqueo nuevo hasta LOCKOUT_MAX_SECONDS.
LOCKOUT_THRESHOLD=5
LOCKOUT_BASE_SECONDS=300
LOCKOUT_MAX_SECONDS=3600

# Rate limiting (ventana fija en Redis)
LOGIN_RATE_LIMIT_IP_MAX=10
LOGIN_RATE_LIMIT_EMAIL_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
TRACKING_RATE_LIMIT_MAX=5
TRACKING_RATE_LIMIT_WINDOW_SECONDS=900
SHIPMENTS_RATE_LIMIT_MAX=60
SHIPMENTS_RATE_LIMIT_WINDOW_SECONDS=60
NOTIFICATIONS_RATE_LIMIT_MAX=60
NOTIFICATIONS_RATE_LIMIT_WINDOW_SECONDS=60

# Almacenamiento privado de objetos (S3 compatible; MinIO en Docker Compose).
# STORAGE_ENDPOINT es el que usa el servidor (Compose lo sustituye por http://minio:9000).
# STORAGE_PUBLIC_ENDPOINT es el host que firma las URLs y que abre el navegador.
# Con APP_ENV=production todas son obligatorias y no admiten valores de ejemplo.
STORAGE_HOST_PORT=9000
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=rutasegura-private
# Cuenta de solo lectura que minio-init crea para la app.
STORAGE_ACCESS_KEY_ID=rutasegura-app
STORAGE_SECRET_ACCESS_KEY=local_only_change_me_app
# Cuenta administradora de MinIO: solo la usan los contenedores minio y minio-init.
MINIO_ROOT_USER=rutasegura-root
MINIO_ROOT_PASSWORD=local_only_change_me_root
# Vigencia de cada URL firmada de descarga (máximo 300).
SIGNED_URL_TTL_SECONDS=60
DOCUMENTS_RATE_LIMIT_MAX=30
DOCUMENTS_RATE_LIMIT_WINDOW_SECONDS=60

# Observabilidad: debug | info | warn | error
LOG_LEVEL=info
