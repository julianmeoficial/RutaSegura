# Copiar como .env en la raíz. Nunca versionar .env ni poner valores reales aquí.

# Runtime
NODE_ENV=development
# development | preview | production. Fuera de production se envía X-Robots-Tag: noindex.
APP_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Puertos que Docker Compose publica en el host. Si ya tienes PostgreSQL o Redis
# locales, cámbialos (por ejemplo 55432 y 56379) y ajusta DATABASE_URL y REDIS_URL.
APP_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# PostgreSQL: valores locales de ejemplo. Docker Compose sustituye el host por "postgres".
DATABASE_URL=postgresql://rutasegura:local_only_change_me@localhost:5432/rutasegura

# Redis. Docker Compose sustituye el host por "redis".
REDIS_URL=redis://localhost:6379

# Auth: generar valores reales fuera del repositorio (openssl rand -base64 32).
# Con APP_ENV=production la app no arranca si detecta estos valores de ejemplo.
SESSION_SECRET=replace_with_at_least_32_random_bytes
CSRF_SECRET=replace_with_at_least_32_random_bytes
HMAC_SECRET=replace_with_at_least_32_random_bytes
SESSION_TTL_SECONDS=3600

# Rate limiting
TRACKING_RATE_LIMIT_MAX=5
TRACKING_RATE_LIMIT_WINDOW_SECONDS=900

# Almacenamiento privado de objetos (phase 10)
STORAGE_ENDPOINT=https://replace-me.example.com
STORAGE_REGION=replace-me
STORAGE_BUCKET=rutasegura-private
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me
SIGNED_URL_TTL_SECONDS=60

# Observabilidad: debug | info | warn | error
LOG_LEVEL=info
